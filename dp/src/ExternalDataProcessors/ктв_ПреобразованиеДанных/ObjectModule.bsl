//
Процедура УстановитьБезопасныйРежимПД(НовоеЗначение) Экспорт
	
	Если ТипЗнч(НовоеЗначение) = Тип("Булево") Тогда
		БезопасныйРежимПД = НовоеЗначение;
	Иначе
