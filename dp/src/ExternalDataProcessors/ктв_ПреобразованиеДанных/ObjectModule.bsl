// из структуры описания объекта
//
// Параметры:
//     Объект             - ОформляемыеПоляКомпоновкиДанных - заполняемый объект
//     СтруктураОбъекта   - Структура                       - данные для заполнения объекта
//
Процедура ОформляемыеПоляСКДИзСтруктуры(Объект, СтруктураОбъекта)
	
	Если НЕ ТипЗнч(Объект) = Тип("ОформляемыеПоляКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	СвойствоОбъектаСКДИзМассива(Объект, СтруктураОбъекта, "Элементы");
	
КонецПроцедуры // ОформляемыеПоляСКДИзСтруктуры()

// Функция - заполняет и возвращает структуру описания объекта СКД
// ПолеКомпоновкиДанных
//
// Параметры:
//     Объект             - ОформляемыеПоляКомпоновкиДанных     - заполняемый объект
//
// Возвращаемое значение:
//     Структура          - структура описания объекта
//
Функция ПолеСКДВСтруктуру(Объект)
	
	СтруктураОбъекта = Новый Структура();
	
	Если НЕ ТипЗнч(Объект) = Тип("ПолеКомпоновкиДанных") Тогда
		СтруктураОбъекта.Вставить("__Тип", "Неопределено");
		Возврат СтруктураОбъекта;
	КонецЕсли;
	
	СтруктураОбъекта.Вставить("__Тип", "ПолеКомпоновкиДанных");
	
	СтруктураОбъекта.Вставить("Имя", СокрЛП(Объект));
	
	Возврат СтруктураОбъекта;
	
КонецФункции // ПолеСКДВСтруктуру()

// Процедура - заполняет объект СКД ПолеКомпоновкиДанных
// из структуры описания объекта
//
// Параметры:
//     Объект             - ОформляемыеПоляКомпоновкиДанных - заполняемый объект
//     СтруктураОбъекта   - Структура                       - данные для заполнения объекта
//
Процедура ПолеСКДИзСтруктуры(Объект, СтруктураОбъекта)
	
	Если НЕ ТипЗнч(Объект) = Тип("ПолеКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Новый ПолеКомпоновкиДанных(СтруктураОбъекта.Имя);
	
КонецПроцедуры // ПолеСКДИзСтруктуры()

#КонецОбласти // ПреобразованияСКДПроцедурыПреобразованияОбъектов

#Область ПреобразованияСКДСлужебные

// Функция - заполняет и возвращает структуру описания объекта СКД
//
// Параметры:
//     Объект             - Произвольный     - преобразуемый объект
//
// Возвращаемое значение:
//     Структура          - структура описания объекта
//
Функция ЗначениеСКДВСтруктуру(Объект)
	
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Объект);
	
	// TODO: Обработка нештатной ситуации, когда в конфигурации отсутствует тип значения
	// видимо ошибка переноса отчета из другой конфигурации
	Если ПолучитьТипСтрокой(ТипЗначения) = "ПредопределенноеЗначениеКомпоновкиДанных" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПрефиксИмениМетодаПреобразования = ТипыЗначенийСКД().Получить(ТипЗначения);
	
	Если ПрефиксИмениМетодаПреобразования = Неопределено Тогда
		ПоказатьСообщение(СтрШаблон("Неизвестный тип %1 объекта СКД: %2", ТипЗначения, Объект));
		Возврат Неопределено;
	КонецЕсли;
	
	Если БезопасныйРежимПД() Тогда
		УстановитьБезопасныйРежим(Истина);
	КонецЕсли;
	
	Возврат Вычислить(СтрШаблон("%1ВСтруктуру(Объект)", ПрефиксИмениМетодаПреобразования));
	
КонецФункции // ЗначениеСКДВСтруктуру()

// Процедура - заполняет объект СКД из структуры описания объекта
//
// Параметры:
//     Объект             - Произвольный          - заполняемый объект СКД
//     СтруктураОбъекта   - Структура             - данные для заполнения объекта
//
Процедура ЗначениеСКДИзСтруктуры(Объект, СтруктураОбъекта)
	
	Если ЕстьТип(СтруктураОбъекта) Тогда
		ТипЗначения = Тип(СтруктураОбъекта.__Тип);
	Иначе
		ТипЗначения = ТипЗнч(Объект);
	КонецЕсли;
	
	ПрефиксИмениМетодаПреобразования = ТипыЗначенийСКД().Получить(ТипЗначения);
	
	Если ПрефиксИмениМетодаПреобразования = Неопределено Тогда
		ПоказатьСообщение(СтрШаблон("Неизвестный тип %1 объекта СКД: %2", ТипЗначения, Объект));
		Возврат;
	КонецЕсли;
	
	Если БезопасныйРежимПД() Тогда
		УстановитьБезопасныйРежим(Истина);
	КонецЕсли;
	
	Выполнить(СтрШаблон("%1ИзСтруктуры(Объект, СтруктураОбъекта)", ПрефиксИмениМетодаПреобразования));
	
КонецПроцедуры // ЗначениеСКДИзСтруктуры()
 
// Функция - заполняет массив элементами по данным коллекции СКД
//
// Параметры:
//     Коллекция    - Произвольный    - заполняемый объект
//
// Возвращаемое значение:
//     Массив из Структура     - массив элементов-описаний объектов
//
Функция КоллекцияСКДВМассив(Коллекция)
	
	МассивЭлементов = Новый Массив();
	Для Каждого ТекЭлемент Из Коллекция Цикл
		МассивЭлементов.Добавить(ЗначениеСКДВСтруктуру(ТекЭлемент));
	КонецЦикла;
	
	Возврат МассивЭлементов;
	
КонецФункции // КоллекцияСКДВМассив()

// Процедура - заполняет коллекцию СКД из массива описаний объектов
//
// Параметры:
//     Коллекция              - Произвольный         - заполняемая коллекция
//     МассивКоллекции        - Массив из Структура  - данные для заполнения коллекции
//     УстановитьТипЭлемента  - Булево               - Истина - при добавлении элемента в коллекцию,
//                                                     будет указан тип элемента
//
// @skip-check bsl-legacy-check-dynamic-feature-access
Процедура КоллекцияСКДИзМассива(Коллекция, МассивКоллекции, Знач УстановитьТипЭлемента = Ложь)
	
	Для Каждого ТекЭлемент Из МассивКоллекции Цикл
		УстановитьТипЭлемента = УстановитьТипЭлемента
		                      И НЕ (ТипЗнч(Коллекция) = Тип("КоллекцияЭлементовСтруктурыТаблицыКомпоновкиДанных")
		                        ИЛИ ТипЗнч(Коллекция) = Тип("КоллекцияЭлементовСтруктурыДиаграммыКомпоновкиДанных")
		                        ИЛИ ТипЗнч(Коллекция) = Тип("КоллекцияЭлементовУсловногоОформленияКомпоновкиДанных"));
		
		Если УстановитьТипЭлемента Тогда
			НовыйЭлемент = Коллекция.Добавить(Тип(ТекЭлемент.__Тип));
		Иначе
			НовыйЭлемент = Коллекция.Добавить();
		КонецЕсли;
		ЗначениеСКДИзСтруктуры(НовыйЭлемент, ТекЭлемент);
	КонецЦикла;
	
КонецПроцедуры // КоллекцияСКДИзМассива()

// Процедура - заполняет указанный элемент объекта СКД из структуры описания объекта
//
// Параметры:
//     Объект                 - Произвольный        - заполняемый объект
//     СтруктураОбъекта       - Структура           - данные для заполнения объекта
//     Свойство               - Строка              - имя заполняемого свойства
//     ЗначениеСКД            - Булево              - Истина - значение будет приобразовано в объект СКД
//
Процедура СвойствоОбъектаСКДИзСтруктуры(Объект, СтруктураОбъекта, Свойство, ЗначениеСКД = Ложь)
	
	Если СтруктураОбъекта.Свойство(Свойство) Тогда
		Если ЗначениеСКД Тогда
			ЗначениеСКДИзСтруктуры(Объект[Свойство], СтруктураОбъекта[Свойство]);
		Иначе
			Объект[Свойство] = СтруктураОбъекта[Свойство];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // СвойствоОбъектаСКДИзСтруктуры()

// Процедура - заполняет указанный элемент-коллекцию объекта СКД из структуры описания объекта
//
// Параметры:
//   Объект                 - Произвольный     - заполняемый объект
//   СтруктураОбъекта       - Структура        - данные для заполнения объекта
//   Свойство               - Строка           - имя заполняемого свойства-коллекции
//   УстановитьТипЭлемента  - Булево           - Истина - при добавлении элемента в коллекцию,
//                                               будет указан тип элемента
//
Процедура СвойствоОбъектаСКДИзМассива(Объект, СтруктураОбъекта, Свойство, УстановитьТипЭлемента = Ложь)
	
	Если СтруктураОбъекта.Свойство(Свойство) Тогда
		КоллекцияСКДИзМассива(Объект[Свойство], СтруктураОбъекта[Свойство], УстановитьТипЭлемента);
	КонецЕсли;
	
КонецПроцедуры // СвойствоОбъектаСКДИзМассива()

#КонецОбласти // ПреобразованияСКДСлужебные

#Область ПреобразованияОбъектовСлужебные

// Функция определяет тип значения, сохраненного в массив или структуру
// для преобразования в значение 1С
//
// Параметры:
//   СтруктураЗначения    - Структура                - Проверяемое значения
//                          Массив из Произвольный
//
// Возвращаемое значение:
//   Тип    - тип 1С
//
Функция СтруктураТипЗнч(СтруктураЗначения)
	
	Если ТипЗнч(СтруктураЗначения) = Тип("Массив") Тогда
		Если СтруктураЗначения.Количество() = 0 Тогда
			Возврат Тип("Массив");
		КонецЕсли;
		Если ТипЗнч(СтруктураЗначения[0]) = Тип("Структура") Тогда
			ЭтоСоответствие = (СтруктураЗначения[0].Свойство("Ключ")
				             И СтруктураЗначения[0].Свойство("Значение"));
			ЭтоСписок = (СтруктураЗначения[0].Свойство("Представление")
				       И СтруктураЗначения[0].Свойство("Значение")
				       И СтруктураЗначения[0].Свойство("Пометка"));
			Если ЭтоСоответствие Тогда
				Возврат Тип("Соответствие");
			ИначеЕсли ЭтоСписок Тогда
				Возврат Тип("СписокЗначений");
			Иначе
				Возврат Тип("ТаблицаЗначений");
			КонецЕсли;
		КонецЕсли;
		Возврат Тип("Массив");
	ИначеЕсли ТипЗнч(СтруктураЗначения) = Тип("Структура") Тогда
		Если ЕстьТип(СтруктураЗначения) Тогда
			Возврат Тип(СтруктураЗначения.__Тип);
		ИначеЕсли ЭтоОписаниеТипов(СтруктураЗначения) Тогда
			Если ТипЗнч(СтруктураЗначения.Типы) = Тип("Массив") Тогда
				Возврат Тип("ОписаниеТипов");
			КонецЕсли;
		ИначеЕсли СтруктураЗначения.Свойство("Строки") Тогда
			Если ТипЗнч(СтруктураЗначения.Строки) = Тип("Массив") Тогда
				Возврат Тип("ДеревоЗначений");
			КонецЕсли;
		КонецЕсли;
	
		Возврат Тип("Структура");
	Иначе
		Возврат ТипЗнч(СтруктураЗначения);
	КонецЕсли;
	
КонецФункции // СтруктураТипЗнч()

// Функция - возвращает тип объекта, указанный в описании объекта
//
// Параметры:
//   СтруктураОбъекта    - Структура    - структура описания объекта
//
// Возвращаемое значение:
//   Строка    - тип объекта, указанный в описании объекта
//
Функция ТипОбъектаВОписании(СтруктураОбъекта)
	
	ТипОбъекта = "NULL";
	Если ЕстьСсылка(СтруктураОбъекта) И СтруктураОбъекта.Ссылка.Свойство("Тип") Тогда 
		ТипОбъекта = СтруктураОбъекта.Ссылка.Тип;
	ИначеЕсли ЕстьСсылка(СтруктураОбъекта) И ЕстьТип(СтруктураОбъекта.Ссылка) Тогда 
		ТипОбъекта = СтруктураОбъекта.Ссылка.__Тип;
	ИначеЕсли ЕстьТип(СтруктураОбъекта) Тогда 
		ТипОбъекта = СтруктураОбъекта.__Тип;
	Иначе
		ТекстОшибки = "Структура не содержит указания типа значения
		              | или не является представлением ссылочного объекта. Поля %1 объекта:";
	
		Если ЕстьСсылка(СтруктураОбъекта) Тогда
			ВремСтруктура = СтруктураОбъекта.Ссылка;
			ТекстОшибки = СтрШаблон(ТекстОшибки, "ссылки");
		Иначе
			ВремСтруктура = СтруктураОбъекта;
			ТекстОшибки = СтрШаблон(ТекстОшибки, "структуры");
		КонецЕсли;
		ДополнитьТекстПолямиСтруктуры(ТекстОшибки, ВремСтруктура);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат ТипОбъекта;
	
КонецФункции // ТипОбъектаВОписании()

// Проверяет использование свойства (по имени) в соответствии со списками используемых и исключаемых свойств
//
// Параметры:
//  ИмяСвойства         - Строка                    - Имя проверяемого свойства
//  СписокСвойств       - Строка                    - список допустимых свойств
//                        Массив из Строка            (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                    - список исключаемых свойств
//                        Массив из Строка            (если пустой, то допустимы все свойства)
//
// Возвращаемое значение:
//   Булево             - Истина - свойство используется; Ложь - свойство не используется
//
Функция ИспользоватьСвойство(Знач ИмяСвойства, Знач СписокСвойств = Неопределено, Знач ИсключаяСвойства = Неопределено)
	
	Если ТипЗнч(СписокСвойств) = Тип("Строка") Тогда
		СписокСвойств = СтрРазделить(СписокСвойств, ",", Ложь);
	КонецЕсли;
	Если НЕ ТипЗнч(СписокСвойств) = Тип("Массив") Тогда
		СписокСвойств = Новый Массив();
	КонецЕсли;
	
	Если ТипЗнч(ИсключаяСвойства) = Тип("Строка") Тогда
		ИсключаяСвойства = СтрРазделить(ИсключаяСвойства, ",", Ложь);
	КонецЕсли;
	Если НЕ ТипЗнч(ИсключаяСвойства) = Тип("Массив") Тогда
		ИсключаяСвойства = Новый Массив();
	КонецЕсли;
	
	Если СписокСвойств.Количество() = 0 И ИсключаяСвойства.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ИсключаяСвойства.Найти(ИмяСвойства) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (НЕ СписокСвойств.Найти(ИмяСвойства) = Неопределено) ИЛИ СписокСвойств.Количество() = 0;
	
КонецФункции // ИспользоватьСвойство()

// Преобразует переданную дату в структуру если установлен флаг "РасширенноеПредставлениеДаты"
//
// Параметры:
//  Значение    - Дата    - Преобразуемое значение
//
// Возвращаемое значение:
//   Структура                           - результат преобразования
//     *__Тип            - Строка          - тип значения
//     *Значение         - Произвольный    - значение
//     *Представление    - Строка          - представление значения
//
Функция ДатаВСтруктуру(Значение)
	
	Если Не ТипЗнч(Значение) = Тип("Дата") Тогда
		ТекстОшибки = СтрШаблон("Некорректный тип параметра ""Значение"" ""%1"", ожидается тип ""Дата"".",
		                        ТипЗнч(Значение));
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если РасширенноеПредставлениеДаты() Тогда
		СтруктураЗначения = Новый Структура();
		СтруктураЗначения.Вставить("__Тип"        , "Дата");
		СтруктураЗначения.Вставить("Значение"     , Значение);
		СтруктураЗначения.Вставить("Представление", Формат(Значение, "dd.MM.yyyy HH:mm:ss"));
	Иначе
		СтруктураЗначения = Значение;
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции // ДатаВСтруктуру()

// Получает значение даты из переданного описания
//
// Параметры:
//  СтруктураЗначения      - Структура    - Описание значение
//
// Возвращаемое значение:
//   Дата     - результат преобразования
//
Функция ДатаИзСтруктуры(СтруктураЗначения)
	
	ТипЗначения = ТипЗнч(СтруктураЗначения);
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат СтруктураЗначения;
	КонецЕсли;
	
	Если НЕ ТипЗнч(СтруктураЗначения) = Тип("Структура") Тогда
		ТекстОшибки = СтрШаблон("Некорректный тип параметра ""СтруктураЗначения"" ""%1"",
		                        |ожидается тип ""Дата"" или ""Структура"".",
		                        ТипЗнч(СтруктураЗначения));
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если НЕ ЕстьТип(СтруктураЗначения) Тогда
		ТекстОшибки = "Параметр ""СтруктураЗначения"" не содержит поля ""__Тип"". Поля: ";
		ДополнитьТекстПолямиСтруктуры(ТекстОшибки, СтруктураЗначения);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Если НЕ СтруктураЗначения.__Тип = "Дата" Тогда
		ТекстОшибки = СтрШаблон("В параметре ""СтруктураЗначения"" передан некорректный тип для преобразования ""%1""
		                        |Ожидается тип ""Дата"".",
		                        СтруктураЗначения.__Тип);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат СтруктураЗначения.Значение;
	
КонецФункции // ДатаИзСтруктуры()

// Преобразует переданное значение для которого не предусмотрено функции преобразования в структуру
//
// Параметры:
//  Значение    - Произвольный    - Преобразуемое значение
//
// Возвращаемое значение:
//   Структура                           - результат преобразования
//     *__Тип            - Строка          - тип значения
//     *Значение         - Произвольный    - значение
//     *Представление    - Строка          - представление значения
//
Функция ЗначениеНеопределенногоТипаВСтруктуру(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип"        , ПолучитьТипСтрокой(ТипЗначения));
	СтруктураЗначения.Вставить("Значение"     , Значение);
	СтруктураЗначения.Вставить("Представление", СокрЛП(Значение));
	
	Возврат СтруктураЗначения;
	
КонецФункции // ЗначениеНеопределенногоТипаВСтруктуру()

// Получает значение системного перечисления из переданного описания
//
// Параметры:
//  СтруктураЗначения      - Структура    - Описание значение
//
// Возвращаемое значение:
//   Произвольный     - результат преобразования
//
Функция ЗначениеНеопределенногоТипаИзСтруктуры(СтруктураЗначения)
	
	Если СтруктураЗначения.Свойство("Значение") Тогда
		Возврат СтруктураЗначения.Значение;
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции // ЗначениеНеопределенногоТипаИзСтруктуры()

// Преобразует переданный элемент стиля (Картинка, Цвет, Шрифт, Рамка, Линия) в структуру
//
// Параметры:
//  Значение    - Картинка, Цвет, Шрифт, Рамка, Линия    - преобразуемый элемент стиля
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция ЭлементСтиляВСтруктуру(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Картинка") Тогда
		Возврат КартинкаВСтруктуру(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Цвет") Тогда
		Возврат ЦветВСтруктуру(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Шрифт") Тогда
		Возврат ШрифтВСтруктуру(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Рамка") Тогда
		Возврат РамкаВСтруктуру(Значение);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Линия") Тогда
		Возврат ЛинияВСтруктуру(Значение);
	КонецЕсли;
	
	Возврат ЗначениеНеопределенногоТипаВСтруктуру(Значение);
	
КонецФункции // ЭлементСтиляВСтруктуру()

// Получает элемент стиля (Картинка, Цвет, Шрифт, Рамка, Линия) из переданного описания
//
// Параметры:
//  СтруктураЗначения      - Структура      - описание элемета стиля
//
// Возвращаемое значение:
//   Картинка, Цвет, Шрифт, Рамка, Линия     - результат преобразования
//
Функция ЭлементСтиляИзСтруктуры(СтруктураЗначения)
	
	ТипЗначения = СтруктураТипЗнч(СтруктураЗначения);
	
	Если ТипЗначения = Тип("Картинка") Тогда
		Возврат КартинкаИзСтруктуры(СтруктураЗначения);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Цвет") Тогда
		Возврат ЦветИзСтруктуры(СтруктураЗначения);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Шрифт") Тогда
		Возврат ШрифтИзСтруктуры(СтруктураЗначения);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Рамка") Тогда
		Возврат РамкаИзСтруктуры(СтруктураЗначения);
	КонецЕсли;
	
	Если ТипЗначения = Тип("Линия") Тогда
		Возврат ЛинияИзСтруктуры(СтруктураЗначения);
	КонецЕсли;
	
	Возврат ЗначениеНеопределенногоТипаИзСтруктуры(СтруктураЗначения);
	
КонецФункции // ЭлементСтиляИзСтруктуры()

// Преобразует переданную картинку в структуру
//
// Параметры:
//  Значение    - Картинка    - преобразуемая картинка
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция КартинкаВСтруктуру(Значение)
	
	Если НЕ ТипЗнч(Значение) = Тип("Картинка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип", "Картинка");
	СтруктураЗначения.Вставить("Вид"    , ЗначениеВСтруктуру(Значение.Вид));
	
	Если Значение.Вид = ВидКартинки.ИзБиблиотеки Тогда
		ИмяКартинки = Картинки().Библиотека.Получить(Значение);
		СтруктураЗначения.Вставить("Имя", ИмяКартинки);
	ИначеЕсли Значение.Вид = ВидКартинки.Абсолютная Тогда
		СтруктураЗначения.Вставить("Данные",  Значение.ПолучитьДвоичныеДанные());
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции // КартинкаВСтруктуру()

// Получает картинку из переданного описания
//
// Параметры:
//  СтруктураЗначения    - Структура    - описание картинки
//
// Возвращаемое значение:
//   Картинка    - результат преобразования
//
Функция КартинкаИзСтруктуры(СтруктураЗначения)
	
	Если НЕ ВРег(СтруктураЗначения.__Тип) = "КАРТИНКА" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = ЗначениеИзСтруктуры(СтруктураЗначения.Вид);
	
	Если СтруктураЗначения.Свойство("Имя") И ЗначениеЗаполнено(СтруктураЗначения.Имя) Тогда
		Значение = БиблиотекаКартинок[СтруктураЗначения.Имя];
	ИначеЕсли Вид = ВидКартинки.Абсолютная Тогда
		Значение = Новый Картинка(СтруктураЗначения.Данные);
	Иначе
		Значение = Новый Картинка();
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // КартинкаИзСтруктуры()

// Преобразует переданный цвет в структуру
//
// Параметры:
//  Значение    - Цвет    - преобразуемый цвет
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция ЦветВСтруктуру(Значение)
	
	Если НЕ ТипЗнч(Значение) = Тип("Цвет") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип", "Цвет");
	СтруктураЗначения.Вставить("Вид"  , ЗначениеВСтруктуру(Значение.Вид));
	
	Если Значение.Вид = ВидЦвета.WebЦвет Тогда
		ИмяЦвета = Цвета().WebЦвета.Получить(Значение);
	ИначеЕсли Значение.Вид = ВидЦвета.WindowsЦвет Тогда
		ИмяЦвета = Цвета().WindowsЦвета.Получить(Значение);
	ИначеЕсли Значение.Вид = ВидЦвета.ЭлементСтиля Тогда
		ИмяЦвета = Цвета().ЭлементыСтиля.Получить(Значение);
	Иначе
		ИмяЦвета = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяЦвета) Тогда
		СтруктураЗначения.Вставить("Имя", ИмяЦвета);
	Иначе
		Абсолютный = Значение.ПолучитьАбсолютный();
		СтруктураЗначения.Вставить("Зеленый", Абсолютный.Зеленый);
		СтруктураЗначения.Вставить("Красный", Абсолютный.Красный);
		СтруктураЗначения.Вставить("Синий"  , Абсолютный.Синий);
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции // ЦветВСтруктуру()

// Получает цвет из переданного описания
//
// Параметры:
//  СтруктураЗначения    - Структура    - описание цвета
//
// Возвращаемое значение:
//   Цвет    - результат преобразования
//
Функция ЦветИзСтруктуры(СтруктураЗначения)
	
	Если НЕ ВРег(СтруктураЗначения.__Тип) = "ЦВЕТ" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = ЗначениеИзСтруктуры(СтруктураЗначения.Вид);
	
	Если СтруктураЗначения.Свойство("Имя") И ЗначениеЗаполнено(СтруктураЗначения.Имя) Тогда
		Если Вид = ВидЦвета.WebЦвет Тогда
			Значение = WebЦвета[СтруктураЗначения.Имя];
		ИначеЕсли Вид = ВидЦвета.WindowsЦвет Тогда
			Значение = WindowsЦвета[СтруктураЗначения.Имя];
		ИначеЕсли Вид = ВидЦвета.ЭлементСтиля Тогда
			Значение = ЦветаСтиля[СтруктураЗначения.Имя];
		КонецЕсли;
	Иначе
		//@skip-check new-color
		Значение = Новый Цвет(СтруктураЗначения.Красный,
		                      СтруктураЗначения.Зеленый,
		                      СтруктураЗначения.Синий);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // ЦветИзСтруктуры()

// Преобразует переданный шрифт в структуру
//
// Параметры:
//  Значение    - Шрифт    - преобразуемый шрифт
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция ШрифтВСтруктуру(Значение)
	
	Если НЕ ТипЗнч(Значение) = Тип("Шрифт") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип", "Шрифт");
	СтруктураЗначения.Вставить("Вид"  , ЗначениеВСтруктуру(Значение.Вид));
	
	Если Значение.Вид = ВидШрифта.WindowsШрифт Тогда
		ИмяШрифта = Шрифты().WindowsШрифты.Получить(Значение);
	ИначеЕсли Значение.Вид = ВидШрифта.ЭлементСтиля Тогда
		ИмяШрифта = Шрифты().ЭлементыСтиля.Получить(Значение);
	Иначе
		ИмяШрифта = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяШрифта) Тогда
		СтруктураЗначения.Вставить("Имя", ИмяШрифта);
	Иначе
		Абсолютный = Значение.ПолучитьАбсолютный();
		СтруктураЗначения.Вставить("Шрифт"        , Абсолютный.Имя);
		СтруктураЗначения.Вставить("Размер"       , Абсолютный.Размер);
		СтруктураЗначения.Вставить("Полужирный"   , Абсолютный.Полужирный);
		СтруктураЗначения.Вставить("Наклонный"    , Абсолютный.Наклонный);
		СтруктураЗначения.Вставить("Подчеркивание", Абсолютный.Подчеркивание);
		СтруктураЗначения.Вставить("Зачеркивание" , Абсолютный.Зачеркивание);
		СтруктураЗначения.Вставить("Масштаб"      , Абсолютный.Масштаб);
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции // ШрифтВСтруктуру()

// Получает шрифт из переданного описания
//
// Параметры:
//  СтруктураЗначения    - Структура    - описание шрифта
//
// Возвращаемое значение:
//   Шрифт    - результат преобразования
//
Функция ШрифтИзСтруктуры(СтруктураЗначения)
	
	Если НЕ ВРег(СтруктураЗначения.__Тип) = "ШРИФТ" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = ЗначениеИзСтруктуры(СтруктураЗначения.Вид);
	
	Если СтруктураЗначения.Свойство("Имя") И ЗначениеЗаполнено(СтруктураЗначения.Имя) Тогда
		Если Вид = ВидШрифта.WindowsШрифт Тогда
			Значение = WindowsШрифты[СтруктураЗначения.Имя];
		ИначеЕсли Вид = ВидШрифта.ЭлементСтиля Тогда
			Значение = ШрифтыСтиля[СтруктураЗначения.Имя];
		КонецЕсли;
	Иначе
		//@skip-check new-font
		Значение = Новый Шрифт(СтруктураЗначения.Шрифт,
		                       СтруктураЗначения.Размер,
		                       СтруктураЗначения.Полужирный,
		                       СтруктураЗначения.Наклонный,
		                       СтруктураЗначения.Подчеркивание,
		                       СтруктураЗначения.Зачеркивание,
		                       СтруктураЗначения.Масштаб);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // ШрифтИзСтруктуры()

// Преобразует переданную рамку в структуру
//
// Параметры:
//  Значение    - Рамка    - преобразуемая рамка
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция РамкаВСтруктуру(Значение)
	
	Если НЕ ТипЗнч(Значение) = Тип("Рамка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип", "Рамка");
	СтруктураЗначения.Вставить("Вид"  , ЗначениеВСтруктуру(Значение.Вид));
	
	Если Значение.Вид = ВидРамки.ЭлементСтиля Тогда
		ИмяРамки = Рамки().ЭлементыСтиля.Получить(Значение);
	Иначе
		ИмяРамки = Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяРамки) Тогда
		СтруктураЗначения.Вставить("Имя", ИмяРамки);
	Иначе
		СтруктураЗначения.Вставить("ТипРамки", ЗначениеВСтруктуру(Значение.ТипРамки));
		СтруктураЗначения.Вставить("Толщина" , Значение.Толщина);
	КонецЕсли;
	
	Возврат СтруктураЗначения;
	
КонецФункции // РамкаВСтруктуру()

// Получает рамку из переданного описания
//
// Параметры:
//  СтруктураЗначения    - Структура    - описание рамки
//
// Возвращаемое значение:
//   Рамка    - результат преобразования
//
Функция РамкаИзСтруктуры(СтруктураЗначения)
	
	Если НЕ ВРег(СтруктураЗначения.__Тип) = "РАМКА" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Вид = ЗначениеИзСтруктуры(СтруктураЗначения.Вид);
	
	Если СтруктураЗначения.Свойство("Имя") И ЗначениеЗаполнено(СтруктураЗначения.Имя) Тогда
		Если Вид = ВидРамки.ЭлементСтиля Тогда
			Значение = РамкиСтиля[СтруктураЗначения.Имя];
		КонецЕсли;
	Иначе
		Значение = Новый Рамка(ЗначениеИзСтруктуры(СтруктураЗначения.ТипРамки),
		                       СтруктураЗначения.Толщина);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // РамкаИзСтруктуры()

// Преобразует переданную линию в структуру
//
// Параметры:
//  Значение    - Линия    - преобразуемая линия
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция ЛинияВСтруктуру(Значение)
	
	Если НЕ ТипЗнч(Значение) = Тип("Линия") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип"   , "Линия");
	СтруктураЗначения.Вставить("Отступ"  , Значение.Отступ);
	СтруктураЗначения.Вставить("ТипЛинии", ЗначениеВСтруктуру(Значение.ТипЛинии));
	СтруктураЗначения.Вставить("Толщина" , Значение.Толщина);
	
	Возврат СтруктураЗначения;
	
КонецФункции // ЛинияВСтруктуру()

// Получает линию из переданного описания
//
// Параметры:
//  СтруктураЗначения    - Структура    - описание линии
//
// Возвращаемое значение:
//   Линия    - результат преобразования
//
Функция ЛинияИзСтруктуры(СтруктураЗначения)
	
	Если НЕ ВРег(СтруктураЗначения.__Тип) = "ЛИНИЯ" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипЛинии = ЗначениеИзСтруктуры(СтруктураЗначения.ТипЛинии);
	
	Если ТипЛинии = Тип("ТипЛинииЯчейкиТабличногоДокумента") Тогда
		Значение = Новый Линия(ТипЛинии, СтруктураЗначения.Толщина, СтруктураЗначения.Отступ);
	Иначе
		Значение = Новый Линия(ТипЛинии, СтруктураЗначения.Толщина);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции // ЛинияИзСтруктуры()

// Преобразует переданное значение системного перечисления в структуру
//
// Параметры:
//  Значение    - Произвольный    - преобразуемое значение системного перечисления
//
// Возвращаемое значение:
//   Структура    - результат преобразования
//
Функция ЗначениеСистемногоПеречисленияВСтруктуру(Значение)
	
	ТипЗначения = ТипЗнч(Значение);
	
	ЗначенияПеречисления = СистемныеПеречисления().Получить(ТипЗначения);
	
	Если ЗначенияПеречисления = Неопределено Тогда
		Возврат ЗначениеНеопределенногоТипаВСтруктуру(Значение);
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура();
	СтруктураЗначения.Вставить("__Тип", ПолучитьТипСтрокой(ТипЗначения));
	СтруктураЗначения.Вставить("Значение", ЗначенияПеречисления.Получить(Значение));
	
	Возврат СтруктураЗначения;
	
КонецФункции // ЗначениеСистемногоПеречисленияВСтруктуру()

// Получает системное перечисление из переданного описания
//
// Параметры:
//  СтруктураЗначения    - Структура    - описание системного перечисления
//
// Возвращаемое значение:
//   Произвольный    - результат преобразования (системное перечисление)
//
Функция ЗначениеСистемногоПеречисленияИзСтруктуры(СтруктураЗначения)
	
	ТипЗначения = Тип(СтруктураЗначения.__Тип);
	ЗначенияПеречисления = СистемныеПеречисления().Получить(ТипЗначения);
	Если ЗначенияПеречисления = Неопределено Тогда
		Возврат ЗначениеНеопределенногоТипаИзСтруктуры(СтруктураЗначения);
	КонецЕсли;
	
	Возврат Вычислить(СтрШаблон("%1.%2", СтруктураЗначения.__Тип, СтруктураЗначения.Значение));
	
КонецФункции // ЗначениеСистемногоПеречисленияИзСтруктуры()

// Функция, возвращает признак использования реквизита иерархического объекта
//
// Параметры:
//     Объект         - СправочникОбъект, СправочникСсылка                         - проверяемый объект 
//                      ПланВидовХарактеристикОбъект, ПланВидовХарактеристикСсылка
//     МетаСвойство   - ОбъектМетаданныхРеквизит                                   - проверяемый реквизит
//     МетаОбъект     - ОбъектМетаданных                                           - метаданные проверяемого объекта
//
// Возвращаемое значение:
//     Булево         - Истина - реквизит используется для объекта,
//                      Ложь - в противном случае
//
Функция СвойствоИерархическогоОбъектаИспользуется(Объект, МетаСвойство, МетаОбъект = Неопределено)
	
	Если МетаОбъект = Неопределено Тогда
		МетаОбъект = Объект.Метаданные();
	КонецЕсли;
	
	Если НЕ МетаОбъект.Иерархический Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрНачинаетсяС(МетаОбъект.ПолноеИмя(), "Справочник.")
	   И МетаОбъект.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов
	 ИЛИ СтрНачинаетсяС(МетаОбъект.ПолноеИмя(), "ПланВидовХарактеристик.") Тогда
		
		СвойствоИспользуется = 
			(Объект.ЭтоГруппа
				 И МетаСвойство.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента)
			ИЛИ (НЕ Объект.ЭтоГруппа
				 И МетаСвойство.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы);
				
		Если СвойствоИспользуется Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // СвойствоИерархическогоОбъектаИспользуется()

// Проверяет использование свойства объекта и добавляет в структуру
//
// Параметры:
//  СтруктураОбъекта    - Структура                   - заполняемая структура объекта
//  Объект              - Произвольный                - преобразуемый объект
//  ИмяСвойства         - Строка                      - имя добавляемого свойства
//  СписокСвойств       - Строка                      - список допустимых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                      - список исключаемых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//
Процедура СвойствоОбъектаВСтруктуру(СтруктураОбъекта,
                                    Объект,
                                    ИмяСвойства,
                                    СписокСвойств = Неопределено,
                                    ИсключаяСвойства = Неопределено)
	
	Если НЕ ИспользоватьСвойство(ИмяСвойства, СписокСвойств, ИсключаяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОбъекта.Вставить(ИмяСвойства, ЗначениеВСтруктуру(Объект[ИмяСвойства]));
	
КонецПроцедуры // СвойствоОбъектаВСтруктуру()

// Проверяет использование свойства объекта и заполняет значение свойства из структуры
//
// Параметры:
//  Объект              - Произвольный              - Заполняемый объект
//  СтруктураОбъекта    - Структура                 - Структура объекта
//  ИмяСвойства         - Строка                    - Имя проверяемого свойства
//  СписокСвойств       - Строка                    - список допустимых свойств
//                        Массив из Строка            (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                    - список исключаемых свойств
//                        Массив из Строка            (если пустой, то допустимы все свойства)
//
Процедура СвойствоОбъектаИзСтруктуры(Объект,
                                     СтруктураОбъекта,
                                     ИмяСвойства,
                                     СписокСвойств = Неопределено,
                                     ИсключаяСвойства = Неопределено)
	
	Если НЕ СтруктураОбъекта.Свойство(ИмяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИспользоватьСвойство(ИмяСвойства, СписокСвойств, ИсключаяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Объект[ИмяСвойства] = ЗначениеИзСтруктуры(СтруктураОбъекта[ИмяСвойства]);
	Исключение
		ТекстОшибки = СтрШаблон("Ошибка получения значения свойства ""%1"" объекта ""%2"":%3%4",
		                        ИмяСвойства,
		                        СокрЛП(Объект),
		                        Символы.ПС,
		                        ТекстОшибки);
		ЗаписьЖурналаРегистрации("Преобразование данных.Значение свойства",
		                         УровеньЖурналаРегистрации.Предупреждение,
		                         Объект.Ссылка,
		                         Объект.Метаданные(),
		                         ТекстОшибки);
	КонецПопытки;
	
КонецПроцедуры // СвойствоОбъектаИзСтруктуры()

// Добавляет данные табличной части объекта в структуру
//
// Параметры:
//  СтруктураОбъекта   - Структура                 - заполняемая структура объекта
//  Объект             - Произвольный              - преобразуемый объект
//  ИмяТЧ              - Строка                    - имя преобразуемой табличной части
//  СписокСвойств       - Строка                   - список допустимых свойств
//                        Массив из Строка           (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                   - список исключаемых свойств
//                        Массив из Строка           (если пустой, то допустимы все свойства)
//
Процедура ТЧОбъектаВСтруктуру(СтруктураОбъекта,
                              Объект,
                              ИмяТЧ,
                              СписокСвойств = Неопределено,
                              ИсключаяСвойства = Неопределено)
	
	Если НЕ ИспользоватьСвойство(ИмяТЧ, СписокСвойств, ИсключаяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	МетаОбъект = Объект.Метаданные();
	
	МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
	
	Если МетаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = Новый Массив();
	Для Каждого ТекРеквизит Из МетаТЧ.Реквизиты Цикл
		ПутьКДанным = СтрШаблон("%1.%2", ИмяТЧ, ТекРеквизит.Имя);
		Если НЕ ИспользоватьСвойство(ПутьКДанным, СписокСвойств, ИсключаяСвойства) Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты.Добавить(ТекРеквизит.Имя);
	КонецЦикла;
	
	МассивСтрок = Новый Массив();
	Для Каждого ТекСтрока Из Объект[ИмяТЧ] Цикл
		
		СтруктураСтроки = СтрокаЗначенийВСтруктуру(ТекСтрока, Реквизиты);
		СтруктураСтроки.Вставить("НомерСтроки", ТекСтрока.НомерСтроки);
		
		МассивСтрок.Добавить(СтруктураСтроки);
		
	КонецЦикла;
	
	ОписаниеВидаОбъекта = ОписаниеВидаОбъектов(МетаОбъект);
	
	ОписаниеТЧ = Новый Структура();
	ОписаниеТЧ.Вставить("__Тип" , СтрШаблон("%1ТабличнаяЧасть.%2.%3",
	                                        ОписаниеВидаОбъекта.Имя,
	                                        МетаОбъект.Имя,
	                                        ИмяТЧ));
	ОписаниеТЧ.Вставить("Строки", МассивСтрок);
	
	СтруктураОбъекта.Вставить(ИмяТЧ, ОписаниеТЧ);
	
КонецПроцедуры // ТЧОбъектаВСтруктуру()

// Заполняет табличную часть объекта из структуры
//
// Параметры:
//  Объект                - Произвольный              - заполняемый объект
//  СтруктураОбъекта      - Структура                 - структура данных объекта
//  ИмяТЧ                 - Строка                    - имя преобразуемой табличной части
//  СписокСвойств       - Строка                      - список допустимых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                      - список исключаемых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//
Процедура ТЧОбъектаИзСтруктуры(Объект,
                               СтруктураОбъекта,
                               ИмяТЧ,
                               СписокСвойств = Неопределено,
                               ИсключаяСвойства = Неопределено)
	
	Если СтруктураОбъекта.Свойство("__ТЧ") Тогда
		ТЧОбъектаИзСтруктуры_Стар(Объект,
		                          СтруктураОбъекта,
		                          ИмяТЧ,
		                          СписокСвойств = Неопределено,
		                          ИсключаяСвойства = Неопределено);
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураОбъекта.Свойство(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИспользоватьСвойство(ИмяТЧ, СписокСвойств, ИсключаяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	МетаОбъект = Объект.Метаданные();
	
	МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
	
	Если МетаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = Новый Массив();
	Для Каждого ТекРеквизит Из МетаТЧ.Реквизиты Цикл
		ПутьКДанным = СтрШаблон("%1.%2", ИмяТЧ, ТекРеквизит.Имя);
		Если НЕ ИспользоватьСвойство(ПутьКДанным, СписокСвойств, ИсключаяСвойства) Тогда
			Продолжить;
		КонецЕсли;
		Реквизиты.Добавить(ТекРеквизит.Имя);
	КонецЦикла;
	
	Объект[ИмяТЧ].Очистить();
	
	МассивСтрок = СтруктураОбъекта[ИмяТЧ].Строки;
	
	Для й = 0 По МассивСтрок.ВГраница() Цикл
		
		ТекСтрока   = МассивСтрок[й];
		НоваяСтрока = Объект[ИмяТЧ].Добавить();
		
		Попытка
			СтрокаЗначенийИзСтруктуры(НоваяСтрока, ТекСтрока, Реквизиты);
		Исключение
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ВызватьИсключение СтрШаблон("Ошибка заполнения табличной части ""%1"", в строке %2:%3%4",
		                                 ИмяТЧ,
		                                 й,
		                                 Символы.ПС,
		                                 ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры // ТЧОбъектаИзСтруктуры()

// Заполняет табличную часть объекта из структуры
//
// Параметры:
//  Объект                - Произвольный              - заполняемый объект
//  СтруктураОбъекта      - Структура                 - структура данных объекта
//  ИмяТЧ                 - Строка                    - имя преобразуемой табличной части
//  СписокСвойств       - Строка                      - список допустимых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                      - список исключаемых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//
Процедура ТЧОбъектаИзСтруктуры_Стар(Объект,
                                    СтруктураОбъекта,
                                    ИмяТЧ,
                                    СписокСвойств = Неопределено,
                                    ИсключаяСвойства = Неопределено)
	
	Если НЕ СтруктураОбъекта.Свойство("__ТЧ") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ СтруктураОбъекта.__ТЧ.Свойство(ИмяТЧ) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ИспользоватьСвойство("__ТЧ." + ИмяТЧ, СписокСвойств, ИсключаяСвойства) Тогда
		Возврат;
	КонецЕсли;
	
	МетаОбъект = Объект.Метаданные();
	
	МетаТЧ = МетаОбъект.ТабличныеЧасти.Найти(ИмяТЧ);
	
	Если МетаТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект[ИмяТЧ].Очистить();
	
	МассивСтрок = СтруктураОбъекта.__ТЧ[ИмяТЧ].Элементы;
	
	Для й = 0 По МассивСтрок.ВГраница() Цикл
		
		ТекСтрока   = МассивСтрок[й];
		НоваяСтрока = Объект[ИмяТЧ].Добавить();
		
		Для Каждого ТекРеквизит Из МетаТЧ.Реквизиты Цикл
			
			Если НЕ ТекСтрока.Свойство(ТекРеквизит.Имя) Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьКДанным = СтрШаблон("%1.%2", ИмяТЧ, ТекРеквизит.Имя);
			Если НЕ ИспользоватьСвойство(ПутьКДанным, СписокСвойств, ИсключаяСвойства) Тогда
				Продолжить;
			КонецЕсли;
			
			Попытка
				НоваяСтрока[ТекРеквизит.Имя] = ЗначениеИзСтруктуры(ТекСтрока[ТекРеквизит.Имя]);
			Исключение
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВызватьИсключение СтрШаблон("Ошибка получения значения свойства ""%1"" табличной части ""%2"", в строке %3:%4%5",
				                                 ТекРеквизит.Имя,
				                                 ИмяТЧ,
				                                 й,
				                                 Символы.ПС,
				                                 ТекстОшибки);
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры // ТЧОбъектаИзСтруктуры_Стар()

// Добавляет данные записи регистра (значения измерений, ресурсов, реквизитов) в структуру
//
// Параметры:
//  СтруктураЗаписи    - Структура           - заполняемая структура записи регистра
//  Запись             - Произвольный        - исходная запись регистра
//  СписокСвойств      - Строка              - список допустимых свойств
//                       Массив из Строка      (если пустой, то допустимы все свойства)
//  ИсключаяСвойства   - Строка              - список исключаемых свойств
//                       Массив из Строка      (если пустой, то допустимы все свойства)
//
Процедура ЗаполнитьДанныеЗаписиРегистраВСтруктуре(СтруктураЗаписи, Запись, СписокСвойств, ИсключаяСвойства)
	
	МетаОбъект = Метаданные.НайтиПоТипу(ТипЗнч(Запись));
	
	Для Каждого ТекПоле Из МетаОбъект.Измерения Цикл
		Если НЕ ИспользоватьСвойство(ТекПоле.Имя, СписокСвойств, ИсключаяСвойства) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураЗаписи.Вставить(ТекПоле.Имя, ЗначениеВСтруктуру(Запись[ТекПоле.Имя]));
	КонецЦикла;
	
	Для Каждого ТекПоле Из МетаОбъект.Ресурсы Цикл
		Если НЕ ИспользоватьСвойство(ТекПоле.Имя, СписокСвойств, ИсключаяСвойства) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураЗаписи.Вставить(ТекПоле.Имя, ЗначениеВСтруктуру(Запись[ТекПоле.Имя]));
	КонецЦикла;
	
	Для Каждого ТекПоле Из МетаОбъект.Реквизиты Цикл
		Если НЕ ИспользоватьСвойство(ТекПоле.Имя, СписокСвойств, ИсключаяСвойства) Тогда
			Продолжить;
		КонецЕсли;
		СтруктураЗаписи.Вставить(ТекПоле.Имя, ЗначениеВСтруктуру(Запись[ТекПоле.Имя]));
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьДанныеЗаписиРегистраВСтруктуре()

// Заполняет данные записи регистра (значения измерений, ресурсов, реквизитов) из структуры
//
// Параметры:
//  Запись              - Произвольный        - заполняемая запись регистра
//  СтруктураЗаписи     - Структура           - структура данных объекта
//  СписокСвойств       - Строка              - список допустимых свойств
//                        Массив из Строка      (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка              - список исключаемых свойств
//                        Массив из Строка      (если пустой, то допустимы все свойства)
//
Процедура ЗаполнитьДанныеЗаписиРегистраИзСтруктуры(Запись, СтруктураЗаписи, СписокСвойств, ИсключаяСвойства)
	
	МетаОбъект = Метаданные.НайтиПоТипу(ТипЗнч(Запись));
	
	Для Каждого ТекПоле Из МетаОбъект.Измерения Цикл
		Если НЕ (СтруктураЗаписи.Свойство(ТекПоле.Имя)
		   И ИспользоватьСвойство(ТекПоле.Имя, СписокСвойств, ИсключаяСвойства)) Тогда
			Продолжить;
		КонецЕсли;
		Запись[ТекПоле.Имя] = ЗначениеИзСтруктуры(СтруктураЗаписи[ТекПоле.Имя]);
	КонецЦикла;
	
	Для Каждого ТекПоле Из МетаОбъект.Ресурсы Цикл
		Если НЕ (СтруктураЗаписи.Свойство(ТекПоле.Имя)
		   И ИспользоватьСвойство(ТекПоле.Имя, СписокСвойств, ИсключаяСвойства)) Тогда
			Продолжить;
		КонецЕсли;
		Запись[ТекПоле.Имя] = ЗначениеИзСтруктуры(СтруктураЗаписи[ТекПоле.Имя]);
	КонецЦикла;
	
	Для Каждого ТекПоле Из МетаОбъект.Реквизиты Цикл
		Если НЕ (СтруктураЗаписи.Свойство(ТекПоле.Имя)
		   И ИспользоватьСвойство(ТекПоле.Имя, СписокСвойств, ИсключаяСвойства)) Тогда
			Продолжить;
		КонецЕсли;
		Запись[ТекПоле.Имя] = ЗначениеИзСтруктуры(СтруктураЗаписи[ТекПоле.Имя]);
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьДанныеЗаписиРегистраИзСтруктуры()

// Преобразует значения субконто записи регистра бухгалтерии в структуру
//
// Параметры:
//  Запись              - РегистрБухгалтерииЗапись    - Преобразуемая запись регистра бухгалтерии
//  ДтКт                - Строка                      - признак Дт/Кт - "Дт", "Кт", "" 
//  СписокСвойств       - Строка                      - список допустимых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                      - список исключаемых свойств
//                        Массив из Строка              (если пустой, то допустимы все свойства)
//
// Возвращаемое значение:
//   Массив из Структура                                    - результат преобразования
//     *НомерСтроки      - Число                            - Номер субконто
//     *ВидСубконто      - ПланВидовХарактеристикСсылка     - Вид субконто
//     *Значение         - Произвольный                     - Значение субконто
//
Функция ЗначенияСубконтоЗаписиВСтруктуру(Запись,
                                         ДтКт,
                                         СписокСвойств = Неопределено,
                                         ИсключаяСвойства = Неопределено)
	
	ВидыСубконто = Запись["Счет" + ДтКт].ВидыСубконто;
	ЗначенияСубконто = Запись["Субконто" + ДтКт];
	
	МассивСубконто = Новый Массив();
	й = 1;
	Для Каждого ТекСтрокаВида Из ВидыСубконто Цикл
		ПутьКДанным = СтрШаблон("Субконто%1%2", ДтКт, Формат(й, "ЧДЦ=; ЧГ="));
		Если НЕ ИспользоватьСвойство(ПутьКДанным, СписокСвойств, ИсключаяСвойства) Тогда
			й = й + 1;
			Продолжить;
		КонецЕсли;
		ОписаниеСубконто = Новый Структура();
		ОписаниеСубконто.Вставить("НомерСтроки", й);
		ОписаниеСубконто.Вставить("ВидСубконто", ЗначениеВСтруктуру(ТекСтрокаВида.ВидСубконто));
		ОписаниеСубконто.Вставить("Значение"   , ЗначениеВСтруктуру(ЗначенияСубконто[ТекСтрокаВида.ВидСубконто]));
		МассивСубконто.Добавить(ОписаниеСубконто);
		й = й + 1;
	КонецЦикла;
	
	Возврат МассивСубконто;
	
КонецФункции // ЗначенияСубконтоВСтруктуру()

// Заполняет значения субконто записи регистра бухгалтерии из структуры
//
// Параметры:
//  Запись              - РегистрБухгалтерииЗапись  - Заполняемая запись регистра бухгалтерии
//  СтруктураЗаписи     - Структура                 - Структура данных записи регистра бухгалтерии 
//  ДтКт                - Строка                    - признак Дт/Кт - "Дт", "Кт", "" 
//  СписокСвойств       - Строка                    - список допустимых свойств
//                        Массив из Строка            (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                    - список исключаемых свойств
//                        Массив из Строка            (если пустой, то допустимы все свойства)
//
Процедура ЗначенияСубконтоЗаписиИзСтруктуры(Запись,
                                            СтруктураЗаписи,
                                            ДтКт,
                                            СписокСвойств = Неопределено,
                                            ИсключаяСвойства = Неопределено)
	
	ИмяСубконто = СтрШаблон("Субконто%1", ДтКт);
	ВидыСубконто = Запись["Счет" + ДтКт].ВидыСубконто;
	ЗначенияСубконто = Запись[ИмяСубконто];
	
	МассивСубконто = СтруктураЗаписи[ИмяСубконто];
	
	й = 1;
	Для Каждого ТекСтрока Из МассивСубконто Цикл
		
		ИмяСвойства = СтрШаблон("%1%2", ИмяСубконто, Формат(й, "ЧДЦ=; ЧГ="));
		Если НЕ ИспользоватьСвойство(ИмяСвойства, СписокСвойств, ИсключаяСвойства) Тогда
			й = й + 1;
			Продолжить;
		КонецЕсли;
		
		ВидСубконто = ЗначениеИзСтруктуры(ТекСтрока.ВидСубконто);
		
		Если НЕ ЗначениеЗаполнено(ВидСубконто) Тогда
			й = й + 1;
			Продолжить;
		КонецЕсли;
		
		СтрокаВида = ВидыСубконто.Найти(ВидСубконто, "ВидСубконто");
		
		Если СтрокаВида = Неопределено Тогда
			й = й + 1;
			Продолжить;
		КонецЕсли;
		
		ЗначенияСубконто[ВидСубконто] = ЗначениеИзСтруктуры(ТекСтрока.Значение);
		
		й = й + 1;
		
	КонецЦикла;
	
КонецПроцедуры // ЗначенияСубконтоИзСтруктуры()

// Заполняет значение измерения записи регистра бухгалтерии из структуры
// с учетом признаков учета счета
//
// Параметры:
//  Запись               - РегистрБухгалтерииЗапись    - заполняемая запись регистра бухгалтерии
//  СтруктураЗаписи      - Структура                   - структура данных записи регистра бухгалтерии 
//  ОписаниеПоля         - ОбъектМетаданных            - описание метаданных измерения регистра 
//  ДтКт                 - Строка                      - признак Дт/Кт - "Дт", "Кт", "" 
//  СписокСвойств       - Строка                       - список допустимых свойств
//                        Массив из Строка               (если пустой, то допустимы все свойства)
//  ИсключаяСвойства    - Строка                       - список исключаемых свойств
//                        Массив из Строка               (если пустой, то допустимы все свойства)
//
Процедура ЗаполнитьИзмерениеРегистраБухгалтерии(Запись,
                                                СтруктураЗаписи,
                                                ОписаниеПоля,
                                                ДтКт,
                                                СписокСвойств = Неопределено,
                                                ИсключаяСвойства = Неопределено)
	
	Если НЕ (СтруктураЗаписи.Свойство(ОписаниеПоля.Имя + ДтКт)
			 И ИспользоватьСвойство(ОписаниеПоля.Имя, СписокСвойств, ИсключаяСвойства)) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнятьЗначение = Истина;
	
	Если НЕ ОписаниеПоля.ПризнакУчета = Неопределено Тогда
		Если НЕ Запись["Счет" + ДтКт][ОписаниеПоля.ПризнакУчета.Имя] Тогда
			ЗаполнятьЗначение = Ложь;
			Запись[ОписаниеПоля.Имя + ДтКт] = NULL;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗаполнятьЗначение Тогда
		Запись[ОписаниеПоля.Имя + ДтКт] = ЗначениеИзСтруктуры(СтруктураЗаписи[ОписаниеПоля.Имя + ДтКт]);
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьИзмерениеРегистраБухгалтерии()

