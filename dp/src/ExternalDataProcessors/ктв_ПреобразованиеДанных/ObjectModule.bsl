// Функция - возвращает установленный способ обработки "битых" ссылок (на отсутствующие в базе объекты)
//
// Возвращаемое значение:
//   Число    - текущий способ обработки "битых" ссылок
//
Функция СпособОбработкиБитыхСсылок() Экспорт
	
	Если НЕ (ТипЗнч(СпособОбработкиБитыхСсылок) = Тип("Число")
	         И СпособОбработкиБитыхСсылок >= 0 И СпособОбработкиБитыхСсылок <= 2) Тогда
		СпособОбработкиБитыхСсылок = 0;
	КонецЕсли;
	
	Возврат СпособОбработкиБитыхСсылок;
	
КонецФункции // СпособОбработкиБитыхСсылок()

// Процедура - устанавливает способ обработки "битых" ссылок (на отсутствующие в базе объекты)
//
// Параметры:
//   НовоеЗначение    - Число    - новый способ обработки "битых" ссылок (см. СпособыОбработкиБитыхСсылок())
//
Процедура УстановитьСпособОбработкиБитыхСсылок(НовоеЗначение) Экспорт
	
	Если НовоеЗначение = СпособыОбработкиБитыхСсылок().Очищать
	 ИЛИ НовоеЗначение = СпособыОбработкиБитыхСсылок().ВызыватьИсключение Тогда
		ОчиститьБитыеСсылки();
	КонецЕсли;
	
	Если ТипЗнч(НовоеЗначение) = Тип("Число") И НовоеЗначение >= 0 И НовоеЗначение <= 2 Тогда
		СпособОбработкиБитыхСсылок = НовоеЗначение;
	Иначе
		ВызватьИсключение СтрШаблон("Некорректный способ обработки битых ссылок ""%1"", ожидается ""Число"" (0-2)",
		                            НовоеЗначение);
	КонецЕсли;
	
КонецПроцедуры // УстановитьСпособОбработкиБитыхСсылок()

// Функция - возвращает доступные способы обработки "битых" ссылок (на отсутствующие в базе объекты)
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура            - доступные способы обработки "битых" ссылок (на отсутствующие в базе объекты)
//     *Очищать               - Число    - (0) будет возвращена пустая ссылка
//     *Сохранять             - Число    - (1) будет возвращена "битая" ссылка как есть
//     *ВызыватьИсключение    - Число    - (2) будет выбрасываться исключение
//
Функция СпособыОбработкиБитыхСсылок() Экспорт
	
	СпособыОбработки = Новый Структура();
	СпособыОбработки.Вставить("Очищать"           , 0);
	СпособыОбработки.Вставить("Сохранять"         , 1);
	СпособыОбработки.Вставить("ВызыватьИсключение", 2);
	
	Возврат Новый ФиксированнаяСтруктура(СпособыОбработки);
	
КонецФункции // СпособОбработкиБитыхСсылок()

