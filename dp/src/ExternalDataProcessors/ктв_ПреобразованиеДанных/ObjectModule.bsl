// Функция - заполняет и возвращает кэш предопределенных цветов
//
// Возвращаемое значение:
//   Структура  - кэш предопределенных цветов
//
Функция Цвета()
	
	Если НЕ КэшЦветов = Неопределено Тогда
		Возврат КэшЦветов;
	КонецЕсли;
	
	КэшЦветов = Новый Структура();
	
	МакетЦветов = ПолучитьМакет("Цвета");
	
	СписокВидовЦветов = ПрочитатьОписаниеОбъектаИзJSON(МакетЦветов.ПолучитьТекст());
	
	Для Каждого ТекВидЦвета Из СписокВидовЦветов Цикл
		
		СписокЦветов = Новый Соответствие();
		Для Каждого ТекЦвет Из ТекВидЦвета.Значение Цикл
			Если ТекВидЦвета.Ключ = "WebЦвета" Тогда
				СписокЦветов.Вставить(WebЦвета[ТекЦвет], ТекЦвет);
			ИначеЕсли ТекВидЦвета.Ключ = "WindowsЦвета" Тогда
				СписокЦветов.Вставить(WindowsЦвета[ТекЦвет], ТекЦвет);
			ИначеЕсли ТекВидЦвета.Ключ = "ЭлементыСтиля" Тогда
				СписокЦветов.Вставить(ЦветаСтиля[ТекЦвет], ТекЦвет);
			Иначе
				Продолжить;
			КонецЕсли;
		КонецЦикла;
		Если ТекВидЦвета.Ключ = "ЭлементыСтиля" Тогда
			Для Каждого ТекЭлемент Из Метаданные.ЭлементыСтиля Цикл
				Если НЕ ТекЭлемент.Вид = Метаданные.СвойстваОбъектов.ВидЭлементаСтиля.Цвет Тогда
					Продолжить;
				КонецЕсли;
				СписокЦветов.Вставить(ЦветаСтиля[ТекЭлемент.Имя], ТекЭлемент.Имя);
			КонецЦикла;
		КонецЕсли;
		КэшЦветов.Вставить(ТекВидЦвета.Ключ, СписокЦветов);
	КонецЦикла;
	
	Возврат КэшЦветов;
	
КонецФункции // Цвета()

