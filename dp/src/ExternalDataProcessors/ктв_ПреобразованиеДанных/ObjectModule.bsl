//     СтруктураОбъекта   - Структура                         - данные для заполнения объекта
//
Процедура ПолеГруппировкиСКДИзСтруктуры(Объект, СтруктураОбъекта)
	
	Если НЕ ТипЗнч(Объект) = Тип("ПолеГруппировкиКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	СвойствоОбъектаСКДИзСтруктуры(Объект, СтруктураОбъекта, "Использование");
	
	Если СтруктураОбъекта.Свойство("НачалоПериода") И ЗначениеЗаполнено(СтруктураОбъекта.НачалоПериода) Тогда
		Если ТипЗнч(СтруктураОбъекта.НачалоПериода) = Тип("Структура") Тогда
			Если ЭтоСистемноеПеречисление(СтруктураОбъекта.НачалоПериода) Тогда
				Объект.НачалоПериода = ЗначениеСистемногоПеречисленияИзСтруктуры(СтруктураОбъекта.НачалоПериода);
			ИначеЕсли СтруктураОбъекта.НачалоПериода.__Тип = "ПолеКомпоновкиДанных" Тогда
				Объект.НачалоПериода = Новый ПолеКомпоновкиДанных(СтруктураОбъекта.НачалоПериода.Имя);
			Иначе
				ПоказатьСообщение(СтрШаблон("Неизвестный тип поля ""НачалоПериода"": %1", СтруктураОбъекта.НачалоПериода.__Тип));
			КонецЕсли;
		ИначеЕсли ТипЗнч(СтруктураОбъекта.НачалоПериода) = Тип("Строка") Тогда
			Объект.НачалоПериода = Новый ПолеКомпоновкиДанных(СтруктураОбъекта.НачалоПериода);
		ИначеЕсли ТипЗнч(СтруктураОбъекта.НачалоПериода) = Тип("Дата") Тогда
			Объект.НачалоПериода = СтруктураОбъекта.НачалоПериода;
		Иначе
			ПоказатьСообщение(СтрШаблон("Неизвестный тип поля ""НачалоПериода"": %1", СтруктураОбъекта.НачалоПериода));
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураОбъекта.Свойство("КонецПериода") И ЗначениеЗаполнено(СтруктураОбъекта.КонецПериода) Тогда
		Если ТипЗнч(СтруктураОбъекта.КонецПериода) = Тип("Структура") Тогда
			Если ЭтоСистемноеПеречисление(СтруктураОбъекта.КонецПериода) Тогда
				Объект.КонецПериода = ЗначениеСистемногоПеречисленияИзСтруктуры(СтруктураОбъекта.КонецПериода);
			ИначеЕсли СтруктураОбъекта.КонецПериода.__Тип = "ПолеКомпоновкиДанных" Тогда
				Объект.КонецПериода = Новый ПолеКомпоновкиДанных(СтруктураОбъекта.КонецПериода.Имя);
			Иначе
